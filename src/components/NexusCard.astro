---
import type { NexusCard as NexusCardData } from '../data/nexus/types';

const { card, pageId, cardIndex } = Astro.props as {
  card: NexusCardData;
  pageId: string;
  cardIndex: number;
};

const bodyId = `${pageId}-card-${cardIndex}`;
---

<section
  class:list={['glass-panel', 'nexus-card', card.tone === 'danger' && 'nexus-card-danger', card.size === 'wide' && 'nexus-card-wide']}
  style={`--accent-color: ${card.accent};`}
  data-nexus-card
>
  <div class="nexus-card-head">
    <button class="nexus-collapse" type="button" aria-expanded="true" aria-controls={bodyId} data-collapse-toggle>
      <span class="nexus-arrow" aria-hidden="true"></span>
      <span class="sr-only">折叠 {card.title}</span>
    </button>
    <h2>{card.title}</h2>
  </div>

  <div class="nexus-card-body" id={bodyId} data-collapse-body>
    {
      card.sections.map((section) => {
        if (section.type === 'links') {
          return (
            <div
              class:list={['nexus-links', `nexus-links-${section.layout ?? 'grid'}`]}
              style={`--link-columns: ${section.columns ?? 2};`}
            >
              {section.items.map((item) => (
                <a href={item.href} target="_blank" rel="noreferrer" class="nexus-link">
                  <span>{item.label}</span>
                  {item.note && <small>{item.note}</small>}
                </a>
              ))}
            </div>
          );
        }

        if (section.type === 'callout') {
          return (
            <div class="nexus-callout">
              <div>
                <p class="nexus-callout-title">{section.title}</p>
                {section.subtitle && <p class="nexus-callout-subtitle">{section.subtitle}</p>}
              </div>
              <a href={section.href} target="_blank" rel="noreferrer" class="nexus-callout-action">
                {section.action}
              </a>
            </div>
          );
        }

        return (
          <div class="nexus-note">
            <p class="nexus-note-title">{section.title}</p>
            <p>{section.body}</p>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .nexus-card {
    position: relative;
    min-height: 0;
    border-color: color-mix(in srgb, var(--accent-color) 18%, transparent);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.32);
  }

  .nexus-card:hover {
    border-color: color-mix(in srgb, var(--accent-color) 42%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent-color) 18%, transparent);
  }

  .nexus-card-danger {
    border-top: 4px solid var(--accent-color);
  }

  .nexus-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .nexus-card-head h2 {
    color: var(--accent-color);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .nexus-collapse {
    position: relative;
    width: 1.65rem;
    height: 1.65rem;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--accent-color) 45%, rgba(255, 255, 255, 0.2));
    border-radius: 999px;
    color: var(--accent-color);
    background: rgba(15, 23, 42, 0.58);
    cursor: pointer;
    transition: transform 0.22s ease, border-color 0.22s ease, background-color 0.22s ease;
  }

  .nexus-collapse:hover {
    background: color-mix(in srgb, var(--accent-color) 14%, rgba(15, 23, 42, 0.72));
    border-color: var(--accent-color);
  }

  .nexus-arrow {
    display: block;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.46rem;
    height: 0.46rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translate(-50%, -60%) rotate(45deg);
    transform-origin: center;
    transition: transform 0.24s ease;
  }

  .nexus-card.is-collapsed .nexus-arrow {
    transform: translate(-56%, -50%) rotate(-45deg);
  }

  .nexus-card.is-collapsed .nexus-card-body {
    display: none;
  }

  .nexus-card-body {
    display: grid;
    gap: 1.25rem;
  }

  .nexus-links {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
  }

  .nexus-links-grid {
    display: grid;
    grid-template-columns: repeat(var(--link-columns), minmax(0, 1fr));
    gap: 0.75rem;
  }

  .nexus-links-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nexus-links-list {
    display: grid;
    gap: 0.8rem;
  }

  .nexus-link {
    min-height: 2.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 0.45rem;
    color: rgb(226, 232, 240);
    background: rgba(15, 23, 42, 0.52);
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .nexus-links-list .nexus-link {
    justify-content: flex-start;
    min-height: 2.35rem;
  }

  .nexus-links-list .nexus-link::before {
    content: "▶";
    color: var(--accent-color);
  }

  .nexus-link:hover {
    color: white;
    border-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 12%, rgba(15, 23, 42, 0.68));
    transform: translateY(-1px);
  }

  .nexus-link small {
    color: rgb(148, 163, 184);
  }

  .nexus-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(248, 113, 113, 0.32);
    border-radius: 0.8rem;
    background: rgba(220, 38, 38, 0.07);
  }

  .nexus-callout-title {
    color: rgb(248, 113, 113);
    font-weight: 800;
    font-style: italic;
  }

  .nexus-callout-subtitle {
    color: rgb(100, 116, 139);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
    margin-top: 0.2rem;
  }

  .nexus-callout-action {
    flex: 0 0 auto;
    padding: 0.72rem 1.2rem;
    border: 1px solid rgba(248, 113, 113, 0.58);
    border-radius: 0.65rem;
    color: rgb(248, 113, 113);
    background: rgba(220, 38, 38, 0.16);
    font-size: 0.84rem;
    font-weight: 800;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .nexus-callout-action:hover {
    background: rgba(220, 38, 38, 0.32);
    transform: translateY(-1px);
  }

  .nexus-note {
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent-color) 42%, transparent);
    border-radius: 0.55rem;
    background: rgba(15, 23, 42, 0.7);
    color: rgb(203, 213, 225);
    font-size: 0.9rem;
  }

  .nexus-note-title {
    margin-bottom: 0.35rem;
    color: rgb(226, 232, 240);
    font-weight: 800;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .nexus-links-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nexus-callout {
      align-items: stretch;
      flex-direction: column;
    }

    .nexus-callout-action {
      text-align: center;
    }
  }
</style>
