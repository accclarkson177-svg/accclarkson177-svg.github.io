

---
import '../styles/global.css';

const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="nexus-bg-shell bg-black text-white min-h-screen">
    <!-- 背景层：星空与等离子火花塔光晕 -->
    <div class="fixed inset-0 z-0 opacity-30 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-cyan-900 via-slate-950 to-slate-950"></div>
    
    <div class="relative z-10 max-w-6xl mx-auto p-6">
      <slot />
    </div>

    <script is:inline>
      window.setTimeout(() => {
        const body = document.body;
        if (!body) return;

        const backgroundImage = new Image();
        backgroundImage.decoding = 'async';
        backgroundImage.onload = () => {
          body.style.backgroundImage = "url('/ultra-bg.png')";
          body.classList.add('nexus-bg-image-ready');
        };
        backgroundImage.src = '/ultra-bg.png';
      }, 3000);
    </script>

   <style is:global>
      html {
        background: #020617;
      }

      body.nexus-bg-shell {
        background-color: #000;
        background-image:
          radial-gradient(circle at 76% 21%, rgba(148, 163, 184, 0.18) 0 1px, transparent 1.5px),
          radial-gradient(circle at 33% 13%, rgba(226, 232, 240, 0.28) 0 1px, transparent 1.5px),
          radial-gradient(circle at 58% 41%, rgba(125, 211, 252, 0.16) 0 1px, transparent 1.5px),
          radial-gradient(ellipse at 70% 100%, rgba(250, 204, 21, 0.2), transparent 18rem),
          radial-gradient(ellipse at 48% 102%, rgba(96, 165, 250, 0.3), transparent 28rem),
          linear-gradient(155deg, transparent 63%, rgba(30, 64, 175, 0.72) 63.2%, rgba(191, 219, 254, 0.62) 71%, transparent 71.2%),
          linear-gradient(24deg, transparent 67%, rgba(15, 23, 42, 0.95) 67.2%, rgba(37, 99, 235, 0.42) 77%, transparent 77.2%),
          linear-gradient(180deg, #02030d 0%, #050a1b 46%, #0b1936 76%, #050814 100%);
        background-position: center;
        background-size: cover;
        background-attachment: fixed;
      }

      @keyframes color-timer-pulse {
        0%, 100% { box-shadow: 0 0 10px #06b6d4, 0 0 20px #06b6d4; background-color: #06b6d4; }
        50% { box-shadow: 0 0 2px #06b6d4, 0 0 5px #06b6d4; background-color: #0891b2; }
      }
      .timer-safe { animation: color-timer-pulse 2s infinite; }
      
      /* 使用原生 CSS 重写玻璃面板，避开 Tailwind v4 的审查 */
      .glass-panel {
        background-color: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0);
        border-radius: 1rem;
        padding: 1.5rem;
        transition: all 0.3s ease;
      }
      .glass-panel:hover {
        background-color: rgba(255, 255, 255, 0);
        border-color: rgba(255, 255, 255, 0);
      }
    </style>
  </body>
</html>
