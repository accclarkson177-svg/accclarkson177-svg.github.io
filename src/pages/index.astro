---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import NexusCard from '../components/NexusCard.astro';
import { nexusPages } from '../data/nexus';

const quotesPath = join(process.cwd(), 'src', 'data', 'daily-quotes.md');
const quoteLines = existsSync(quotesPath) ? readFileSync(quotesPath, 'utf8').split(/\r?\n/) : [];
const dailyQuotes = quoteLines
  .map((line) => line.trim())
  .filter((line) => line && !line.startsWith('#'))
  .map((line) => line.replace(/^\d+\s*(?:[.)、:：-]\s*)?/, '').trim())
  .filter(Boolean);
const fallbackQuote = dailyQuotes[0] ?? '这是测试';
const fallbackQuoteLength = Array.from(fallbackQuote).length;
const fallbackQuoteSizeClass =
  fallbackQuoteLength > 48 ? 'quote-length-long' : fallbackQuoteLength > 28 ? 'quote-length-medium' : '';

const vocabularyPath = join(process.cwd(), 'src', 'data', 'vocabulary.md');
const vocabularyLines = existsSync(vocabularyPath) ? readFileSync(vocabularyPath, 'utf8').split(/\r?\n/) : [];
const vocabularyEntries = vocabularyLines
  .map((line) => line.trim())
  .filter((line) => line && !line.startsWith('#'))
  .map((line) => line.replace(/^\d+\s*(?:[.)、:：-]\s*)?/, '').trim())
  .map((line) => {
    const [word = '', partOfSpeech = '', ...meaningParts] = line.split('|').map((part) => part.trim());
    return { word, partOfSpeech, meaning: meaningParts.join('|') };
  })
  .filter((entry) => entry.word && entry.partOfSpeech && entry.meaning);
const fallbackVocabulary = vocabularyEntries[0] ?? {
  word: 'artifact',
  partOfSpeech: 'n.',
  meaning: '人工文物',
};
---

<Layout title="Ac's Nexus | 光之国数字枢纽">
  <header class="nexus-omni-bar">
    <div class="glass-panel nexus-omni-panel">
      <div class="nexus-quote-shell">
        <div class="w-4 h-4 rounded-full timer-safe border border-white/50"></div>
        <p class:list={['nexus-daily-quote', fallbackQuoteSizeClass]} data-daily-quote title={fallbackQuote}>
          {fallbackQuote}
        </p>
      </div>
    </div>
    <aside class="glass-panel nexus-omni-panel nexus-word-panel" aria-label="随机单词">
      <div class="nexus-word-content">
        <div class="nexus-word-heading">
          <strong class="nexus-word" data-vocabulary-word>{fallbackVocabulary.word}</strong>
          <span class="nexus-word-pos" data-vocabulary-pos>{fallbackVocabulary.partOfSpeech}</span>
        </div>
        <p class="nexus-word-meaning" data-vocabulary-meaning>{fallbackVocabulary.meaning}</p>
      </div>
    </aside>
    <script type="application/json" id="nexus-daily-quotes" set:html={JSON.stringify(dailyQuotes)}></script>
    <script type="application/json" id="nexus-vocabulary" set:html={JSON.stringify(vocabularyEntries)}></script>
  </header>

  <nav class="glass-panel nexus-subnav" aria-label="Nexus sections">
    {
      nexusPages.map((page, index) => (
        <button type="button" class="nexus-tab" data-nexus-tab={index} aria-selected={index === 0 ? 'true' : 'false'}>
          {page.label}
        </button>
      ))
    }
  </nav>

  <main class="nexus-viewport">
    <div class="nexus-slider" data-nexus-slider>
      {
        nexusPages.map((page, pageIndex) => (
          <section class="nexus-page" data-nexus-page={pageIndex} aria-hidden={pageIndex === 0 ? 'false' : 'true'}>
            <div class="nexus-page-grid">
              {page.columns.map((column) => (
                <div class:list={['nexus-column', `nexus-column-${column.width}`]}>
                  {column.cards.map((card, cardIndex) => (
                    <NexusCard card={card} pageId={page.id} cardIndex={cardIndex} />
                  ))}
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<script>
  const tabs = Array.from(document.querySelectorAll('[data-nexus-tab]'));
  const pages = Array.from(document.querySelectorAll('[data-nexus-page]'));
  const slider = document.querySelector('[data-nexus-slider]');
  const omniBar = document.querySelector('.nexus-omni-bar');

  if (omniBar) {
    const syncOmniBarHeight = () => {
      document.documentElement.style.setProperty('--nexus-omni-height', `${omniBar.getBoundingClientRect().height}px`);
    };
    const omniBarResizeObserver = new ResizeObserver(syncOmniBarHeight);
    syncOmniBarHeight();
    omniBarResizeObserver.observe(omniBar);
  }

  const activatePage = (nextIndex) => {
    if (!slider) return;

    slider.style.transform = `translateX(-${nextIndex * 100}%)`;
    tabs.forEach((tab, index) => {
      tab.setAttribute('aria-selected', String(index === nextIndex));
    });
    pages.forEach((page, index) => {
      page.setAttribute('aria-hidden', String(index !== nextIndex));
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const nextIndex = Number(tab.getAttribute('data-nexus-tab') ?? 0);
      activatePage(nextIndex);
    });
  });

  document.querySelectorAll('[data-nexus-card]').forEach((card) => {
    const button = card.querySelector('[data-collapse-toggle]');
    const body = card.querySelector('[data-collapse-body]');
    if (!button || !body) return;

    button.addEventListener('click', () => {
      const isCollapsed = card.classList.toggle('is-collapsed');
      button.setAttribute('aria-expanded', String(!isCollapsed));
    });
  });

  const quoteNode = document.querySelector('[data-daily-quote]');
  const quoteSourceNode = document.getElementById('nexus-daily-quotes');

  if (quoteNode && quoteSourceNode) {
    const quotes = JSON.parse(quoteSourceNode.textContent || '[]');

    if (quotes.length > 0) {
      const today = new Date();
      const todayKey = `${today.getFullYear()}-${today.getMonth() + 1}-${today.getDate()}`;
      const storageKey = 'nexus-daily-quote';
      const quoteVersion = quotes.join('\n');
      let selectedQuote = '';

      try {
        const cached = JSON.parse(window.localStorage.getItem(storageKey) || 'null');
        if (cached?.date === todayKey && cached?.version === quoteVersion && quotes.includes(cached.quote)) {
          selectedQuote = cached.quote;
        }
      } catch {
        selectedQuote = '';
      }

      if (!selectedQuote) {
        selectedQuote = quotes[Math.floor(Math.random() * quotes.length)];

        try {
          window.localStorage.setItem(
            storageKey,
            JSON.stringify({
              date: todayKey,
              quote: selectedQuote,
              version: quoteVersion,
            }),
          );
        } catch {
          // Ignore storage failures; the quote still renders for this visit.
        }
      }

      quoteNode.textContent = selectedQuote;
      quoteNode.setAttribute('title', selectedQuote);
      const quoteLength = Array.from(selectedQuote).length;
      quoteNode.classList.remove('quote-length-medium', 'quote-length-long');

      if (quoteLength > 48) {
        quoteNode.classList.add('quote-length-long');
      } else if (quoteLength > 28) {
        quoteNode.classList.add('quote-length-medium');
      }
    }
  }

  const vocabularySourceNode = document.getElementById('nexus-vocabulary');
  const vocabularyWordNode = document.querySelector('[data-vocabulary-word]');
  const vocabularyPosNode = document.querySelector('[data-vocabulary-pos]');
  const vocabularyMeaningNode = document.querySelector('[data-vocabulary-meaning]');

  if (vocabularySourceNode && vocabularyWordNode && vocabularyPosNode && vocabularyMeaningNode) {
    const entries = JSON.parse(vocabularySourceNode.textContent || '[]');

    if (entries.length > 0) {
      const storageKey = 'nexus-last-vocabulary';
      let lastVocabulary = '';

      try {
        lastVocabulary = window.sessionStorage.getItem(storageKey) || '';
      } catch {
        lastVocabulary = '';
      }

      const candidates =
        entries.length > 1 ? entries.filter((entry) => `${entry.word}|${entry.partOfSpeech}` !== lastVocabulary) : entries;
      const selectedEntry = candidates[Math.floor(Math.random() * candidates.length)];
      const selectedKey = `${selectedEntry.word}|${selectedEntry.partOfSpeech}`;

      vocabularyWordNode.textContent = selectedEntry.word;
      vocabularyPosNode.textContent = selectedEntry.partOfSpeech;
      vocabularyMeaningNode.textContent = selectedEntry.meaning;

      try {
        window.sessionStorage.setItem(storageKey, selectedKey);
      } catch {
        // Ignore storage failures; random selection still works for this refresh.
      }
    }
  }
</script>

<style>
  .nexus-quote-shell {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
    gap: 1rem;
  }

  .nexus-daily-quote {
    min-width: 0;
    width: 100%;
    color: rgb(207, 250, 254);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-shadow: 0 0 18px rgba(103, 232, 249, 0.34);
    white-space: normal;
    word-break: break-word;
  }

  .nexus-daily-quote.quote-length-medium {
    font-size: 1.02rem;
  }

  .nexus-daily-quote.quote-length-long {
    font-size: 0.92rem;
  }

  .nexus-omni-bar {
    position: sticky;
    top: 1rem;
    z-index: 50;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .nexus-omni-panel {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .nexus-word-panel {
    min-height: 4.5rem;
  }

  .nexus-word-content {
    display: grid;
    align-content: center;
    width: 100%;
    min-width: 0;
    gap: 0.4rem;
  }

  .nexus-word-heading {
    display: flex;
    align-items: baseline;
    min-width: 0;
    gap: 0.55rem;
  }

  .nexus-word {
    min-width: 0;
    color: rgb(255, 255, 255);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .nexus-word-pos {
    flex: none;
    color: rgb(103, 232, 249);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
    font-style: italic;
    font-weight: 700;
  }

  .nexus-word-meaning {
    margin: 0;
    color: rgb(226, 232, 240);
    font-size: 0.88rem;
    letter-spacing: 0;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .nexus-subnav {
    position: sticky;
    top: calc(var(--nexus-omni-height, 4.5rem) + 2rem);
    z-index: 45;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 0.85rem;
  }

  .nexus-tab {
    min-width: 6rem;
    min-height: 2.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 999px;
    color: rgb(203, 213, 225);
    background: rgba(15, 23, 42, 0.55);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-weight: 800;
    letter-spacing: 0;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .nexus-tab:hover,
  .nexus-tab[aria-selected='true'] {
    color: white;
    border-color: rgba(103, 232, 249, 0.72);
    background: rgba(14, 116, 144, 0.28);
    transform: translateY(-1px);
  }

  .nexus-viewport {
    overflow: hidden;
    padding-bottom: 2rem;
  }

  .nexus-slider {
    display: flex;
    align-items: flex-start;
    transition: transform 0.46s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .nexus-page {
    width: 100%;
    flex: 0 0 100%;
  }

  .nexus-page-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .nexus-column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nexus-column-narrow {
    grid-column: span 3;
  }

  .nexus-column-center,
  .nexus-column-wide {
    grid-column: span 6;
  }

  @media (max-width: 900px) {
    .nexus-page-grid {
      grid-template-columns: 1fr;
    }

    .nexus-column,
    .nexus-column-narrow,
    .nexus-column-center,
    .nexus-column-wide {
      grid-column: auto;
    }

    .nexus-subnav {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .nexus-omni-bar {
      position: static;
      grid-template-columns: minmax(0, 1fr);
    }

    .nexus-daily-quote {
      font-size: 0.98rem;
    }

    .nexus-daily-quote.quote-length-medium {
      font-size: 0.9rem;
    }

    .nexus-daily-quote.quote-length-long {
      font-size: 0.82rem;
    }

    .nexus-tab {
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
